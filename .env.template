# Environment
# NODE_ENV is selected by the dev/build/serve commands; do not fix it here.
WEBSITE_URL=https://kalangocafe.com.br
SITE_URL=https://kalangocafe.com.br
# Frontend canonical/SEO URL, read during the Vite build
VITE_SITE_URL=https://kalangocafe.com.br
APPLICATION_ID=

# Better Auth - Configuration
BETTER_AUTH_SECRET=

# Database (Turso)
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Kalango — segredos apenas no .env local, nunca no GitHub
OPS_TOKEN=
ORDER_ACCESS_SECRET=

# Mercado Pago Checkout Pro — produção
MERCADOPAGO_ENV=production
MERCADOPAGO_SELLER_ID=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Resend — exige domínio próprio verificado
RESEND_API_KEY=
EMAIL_FROM=Kalango Cafés Especiais <contato@kalangocafe.com.br>

# Bling — conectar OAuth na Gestão após configurar callback
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=

# Frete — sem token o código original usa cotação estimada
MELHOR_ENVIO_ENV=production
MELHOR_ENVIO_TOKEN=

# Bucket privado Tigris; o app serve fotos por /api/photos
S3_ENDPOINT=https://t3.storage.dev
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Gateway Configuration
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=

# Payments and tracking
AUTUMN_SECRET_KEY=
